{
    "name": "fusani/blizzard",
    "description": "Blizzard api sdk",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\Blizzard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\Blizzard\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
