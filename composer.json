{
    "name": "fusani/blizzard",
    "description": "Blizzard api sdk",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^8.2",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\Blizzard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\Blizzard\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
