{
    "name": "fusani/blizzard",
    "description": "PHP client for the Blizzard Battle.net API: World of Warcraft characters, items, mounts, pets, reputations, realms and Mythic+",
    "type": "library",
    "keywords": [
        "blizzard",
        "battle.net",
        "battlenet",
        "world of warcraft",
        "wow",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/lokisapocalypse/blizzard-api-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Lamb"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^8.2",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\Blizzard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\Blizzard\\": "tests/unit/",
            "Fusani\\Blizzard\\Live\\": "tests/live/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:live": "phpunit --testsuite Live",
        "lint": "pint --test",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
